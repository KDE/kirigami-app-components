include($KDE_DOCS/global/qt-module-defaults.qdocconf)

project = KirigamiSettings
description = Pages and navigation for application settings.

documentationinheaders = true

headerdirs += .
sourcedirs += .
imagedirs  += ../../docs/pics

outputformats = HTML

navigation.landingpage = "Kirigami"

depends += kde kirigami kirigamiaddonsactions qtcore qtquick qtquickcontrols qtgui kirigamiaddonscomponents kirigamiaddonsformcard

qhp.projects = KirigamiSettings

qhp.KirigamiSettings.file          = kirigamisettings.qhp
qhp.KirigamiSettings.namespace     = org.kde.kirigami.settings.$QT_VERSION_TAG
qhp.KirigamiSettings.virtualFolder = kirigamisettings
qhp.KirigamiSettings.indexTitle    = Kirigami Settings
qhp.KirigamiSettings.indexRoot     =

qhp.KirigamiSettings.subprojects = settings

qhp.KirigamiSettings.subprojects.settings.title = Kirigami Settings QML Types
qhp.KirigamiSettings.subprojects.settings.indexTitle = Kirigami Settings QML Types
qhp.KirigamiSettings.subprojects.settings.selectors = qmlmodule:org.kde.kirigami.settings
qhp.KirigamiSettings.subprojects.settings.sortPages = true

tagfile = kirigamisettings.tags
